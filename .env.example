# Copy to .env and fill in. Required by the contextualize and embed stages,
# and by the CLI (queries are embedded through the OpenAI API at query time).
OPENAI_API_KEY=sk-...

# Postgres (conversation/feedback logging - runs via docker-compose.yml).
# docker-compose.yml's postgres service reads these same three values
# directly from this file (compose does this automatically) - so there's
# only one place to set them now, not two kept in sync by hand.
# CHANGE POSTGRES_PASSWORD before deploying anywhere but a local machine -
# "seerah" is a publicly-known default from this exact file.
POSTGRES_HOST=localhost
POSTGRES_DB=seerah
POSTGRES_USER=seerah
POSTGRES_PASSWORD=seerah

# Qdrant. localhost is correct when running scripts/the API directly on the
# host - docker-compose.yml overrides this to http://qdrant:6333 for the
# containerized app service, since containers reach each other by service
# name, not localhost.
QDRANT_URL=http://localhost:6333

# Grafana admin password (docker-compose.yml's grafana service). Optional -
# defaults to "admin" if unset, which is fine for local dev only. CHANGE this
# before deploying anywhere but a local machine.
GRAFANA_ADMIN_PASSWORD=admin

# Only needed for `docker compose --profile proxy up -d` (the Caddyfile) -
# real TLS for a real deployment, not used for local dev. Must be a domain
# name with a public DNS A record already pointing at this host's IP, not an
# IP address or "localhost" - Caddy uses this to request a Let's Encrypt cert
# automatically on first start.
DOMAIN=your-domain.example.com
